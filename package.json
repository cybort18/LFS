{
  "name": "localfastshares",
  "version": "1.0.0",
  "description": "LocalFastShares (LFS) - High-speed local peer-to-peer file transfer over LAN with zero-disk streaming",
  "main": "core/server.js",
  "type": "module",
  "scripts": {
    "start": "node core/server.js",
    "dev": "node core/server.js",
    "desktop": "electron apps/desktop/main.js",
    "desktop:build": "electron-builder --project apps/desktop",
    "mobile:sync": "cap sync --config apps/mobile/capacitor.config.json",
    "test": "playwright test",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "p2p",
    "file-transfer",
    "lan",
    "localfastshares",
    "express",
    "websocket",
    "streaming",
    "offline",
    "pwa",
    "electron",
    "capacitor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "open": "^10.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "electron": "^43.4.0"
  }
}
