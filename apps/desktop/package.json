{
  "name": "lfs-desktop",
  "version": "1.0.0",
  "description": "LocalFastShares Desktop Application with System Tray Daemon",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.localfastshares.desktop",
    "productName": "LocalFastShares",
    "directories": {
      "output": "../../dist/desktop"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../../public/icons/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
